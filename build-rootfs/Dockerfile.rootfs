# build-rootfs/Dockerfile.rootfs

# ── Stage 1: build the vsock/host binaries (musl-static aarch64) ────────────
# This stage deliberately stays on Alpine/musl: it is the only convenient way
# to produce fully static aarch64 binaries (the guest below is glibc). The
# static binaries run unchanged inside the Debian guest — a static musl
# executable needs no loader or shared libs to be present there.
# Uses qemu-user under the hood — no separate cross-toolchain needed.
FROM --platform=linux/arm64 alpine:3.24 AS vsock-builder
RUN apk add --no-cache musl-dev gcc make linux-headers
WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 2: build the Debian rootfs squashfs ───────────────────────────────
# Pinned to linux/arm64 so the build tools and the guest rootfs share an
# architecture: debootstrap and the guest's dpkg/apt calls execute natively
# under the same emulation the other arm64 stages already rely on.
# debootstrap never needs to mount anything — in a plain Docker RUN there is
# no CAP_SYS_ADMIN, but apt/dpkg cope fine without a mounted /proc.
FROM --platform=linux/arm64 debian:trixie AS builder

ARG DEBIAN_SUITE=trixie
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        debootstrap squashfs-tools openssl libcap2-bin \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
# minbase keeps the bootstrap to dpkg/apt essentials; the full guest package
# set is installed inside the chroot by build-rootfs.sh below.
RUN debootstrap --arch=arm64 --variant=minbase --merged-usr \
        "${DEBIAN_SUITE}" /work/rootfs http://deb.debian.org/debian

# Pull in the static binaries built in stage 1 (musl build, glibc-free —
# they need no compat layer in the guest).
COPY --from=vsock-builder /work/vsock-agent/lidroid-vsock-agent /work/rootfs/usr/local/bin/lidroid-vsock-agent
COPY --from=vsock-builder /work/host-bridge/lidroid-hostd /work/rootfs/usr/local/bin/lidroid-hostd
COPY --from=vsock-builder /work/overlay-normalize/lidroid-overlay-normalize /work/rootfs/usr/local/bin/lidroid-overlay-normalize

ARG SYSTEM_VERSION=0
ENV SYSTEM_VERSION=${SYSTEM_VERSION}

ENV DEBIAN_VERSION=${DEBIAN_SUITE}
COPY files /work/files
COPY build-rootfs.sh /work/build-rootfs.sh
RUN chmod +x /work/build-rootfs.sh && /work/build-rootfs.sh

RUN mksquashfs /work/rootfs /work/debian-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend
# (No -no-xattrs: rootless podman's newuidmap/newgidmap need their
# file capabilities preserved; they're stored as security.capability xattr.)

FROM scratch AS export
COPY --from=builder /work/debian-rootfs.squashfs /debian-rootfs.squashfs
