#!/bin/sh
# Serves the offline copy of the LiDroid documentation (docs/guide/, mirrored
# into the squashfs at build time by build-rootfs.sh) over plain HTTP, so it
# can be read from a browser with no network connection.
#
# Runs in the foreground until interrupted (Ctrl-C); forward the port to read
# it from the phone's own browser:
#   lidroid-forward add 9980 9980 tcp
# then open http://127.0.0.1:9980

DOCROOT=/usr/share/doc/lidroid

if [ ! -d "$DOCROOT" ]; then
    echo "lidroid-docs: $DOCROOT not found" >&2
    exit 1
fi

echo "Serving the LiDroid docs at http://127.0.0.1:9980 (Ctrl-C to stop)"
echo "From the phone: lidroid-forward add 9980 9980 tcp, then open http://127.0.0.1:9980"

# Debian's busybox carries the httpd applet in the base binary; there are no
# per-applet symlinks, so call it through the multiplexer.
exec busybox httpd -f -p 9980 -h "$DOCROOT"
