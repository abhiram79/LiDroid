<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+: system splash screen tuned to match the app's own splash
         route — pure black, and the launcher-badge icon slot is swapped for a
         transparent drawable so nothing is drawn — making the launch sequence
         one uninterrupted dark frame. The wordmark itself is drawn by Compose. -->
    <style name="Theme.LiDroid.Splash">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_clear</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
    </style>
</resources>
